{
  "name": "food-court",
  "version": "1.0.0",
  "description": "Food Court — Mais que delivery. Um novo ecossistema de alimentação.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
