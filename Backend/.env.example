# ===== Food Court — variáveis de ambiente =====

# Ambiente da aplicação
NODE_ENV=development

# Chave de assinatura das sessões (obrigatória; gerada automaticamente se ausente)
SESSION_SECRET=troque-esta-chave-por-um-valor-longo-e-aleatorio
# Duração da sessão por inatividade (entre 1 hora e 30 dias).
SESSION_TTL_HOURS=1
# Nunca habilite em produção. Cria as contas conhecidas de demonstração.
SEED_DEMO_DATA=0

# Porta do servidor
PORT=3000

# URL pública usada nos links de redefinição de senha (ex.: https://foodcourt.com.br)
APP_URL=http://localhost:3000
# Domínios adicionais permitidos, separados por vírgula (opcional)
# ALLOWED_ORIGINS=https://foodcourt.nexobg.com.br

# Ative somente atrás de um proxy reverso confiável (Railway, Nginx etc.)
TRUST_PROXY=0

# Cloudflare Turnstile no login. Deixe vazio para desativar localmente.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname público esperado na resposta da Cloudflare (recomendado em produção).
# TURNSTILE_HOSTNAME=foodcourt.com.br

# APENAS DESENVOLVIMENTO: expõe o link de redefinição na resposta da API
# para permitir testar o fluxo sem SMTP. Use 0 em produção.
DEV_EXPOSE_RESET_LINK=1

# Caminho do banco em arquivo JSON
FC_DB_PATH=../banco de dados/runtime/foodcourt-db.json

# Leitura inteligente de cardápio por foto (configure no Railway)
# OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini

# Chave PIX usada apenas pelo gerador local/simulado
PIX_KEY=troque-pela-chave-pix-do-estabelecimento

# No Railway, anexe um Volume ao serviço com mount path /data.
# O projeto detecta RAILWAY_VOLUME_MOUNT_PATH automaticamente.

# ===== Envio de e-mail (preencha para ativar a recuperação real) =====
# Recomendado no Railway Free/Trial/Hobby: API HTTPS da Resend
# RESEND_API_KEY=re_...
# MAIL_FROM=FoodCourt <contato@seudominio.com.br>
#
# SMTP funciona no Railway somente no plano Pro ou superior.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=contato@foodcourt.com.br
# SMTP_PASS=sua-senha-smtp
# MAIL_FROM=Food Court <contato@foodcourt.com.br>
# OAuth Google (callback: APP_URL/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (callback: APP_URL/api/auth/oauth/apple/callback)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Use \n para representar as quebras de linha da chave .p8 em uma única linha.
APPLE_PRIVATE_KEY=
