{
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Backend/package.json": "Backend/package-lock.json",
    "Backend/.env.example": "Backend/.env",
    "README.md": "docs/*.md"
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.tmp-*": true,
    "logs/**/*.log": true,
    "logs/browser-test-artifacts": true,
    "database/runtime/*.json": true,
    "database/runtime/*.tmp": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "logs": true,
    "database/runtime": true,
    "**/.tmp-*": true
  }
}
